{% extends 'site/base.html' %}{% load static %}{% block title %}Entrar — {{ request.tenant.name }}{% endblock %}{% block content %}<link rel="stylesheet" href="{% static 'site/panel.css' %}"><div class="account-card"><div class="eyebrow">{{ request.tenant.slug }} · NOVA INFO</div><h1>{{ request.tenant.name }}</h1><p>Entre com a conta autorizada para este estabelecimento.</p><form method="post">{% csrf_token %}{{ form.as_p }}<input type="hidden" name="next" value="{{ next }}"><button class="button button-primary">Entrar no meu painel →</button></form><p><a href="{% url 'account' %}">Acessar meu ambiente</a></p><p><a href="{% url 'signup' %}">Criar conta</a> · <a href="{% url 'password_reset' %}">Esqueci minha senha</a></p></div>{% endblock %}