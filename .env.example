# Produção: configure estas variáveis no serviço, fora do Git.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=novainfo.com.br,.novainfo.com.br
TENANT_ROOT_DOMAIN=novainfo.com.br
DB_ENGINE=postgres
DB_NAME=novainfo
DB_USER=novainfo_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Gere uma chave Fernet e guarde em um secret manager; não use DJANGO_SECRET_KEY.
ROUTEROS_CREDENTIAL_KEY=
WG_EXECUTABLE=/usr/bin/wg
# ID de usuário Django ativo/staff com operations.manage_network.
WG_MONITOR_USER_ID=
# Assinatura SaaS: a Nova Info recebe a mensalidade do estabelecimento.
# Ative somente após homologar credenciais e eventos de assinatura.
MERCADOPAGO_SUBSCRIPTIONS_ENABLED=false
MERCADOPAGO_LIVE_MODE=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
NOVAINFO_PUBLIC_URL=https://novainfo.com.br
# SMTP Resend. Preencha a senha apenas no ambiente privado do serviço.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="NovaInfo <nao-responda@novainfo.com.br>"
# Alternativas compatíveis: RESEND_API_KEY e RESEND_FROM_EMAIL.
